# --- Supabase (Project Settings > API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=pega-aqui-la-service-role-key

# --- Acceso del equipo: Nombre:clave separados por ; ---
TEAM_USERS=Angel:cambia-esta-clave;José:cambia-esta-clave
# Correo de cada usuario (Gmail con el que se abren los emails y a quien llega el resumen diario)
TEAM_EMAILS=Angel:angelfg1911@gmail.com;José:yonadersanoja@gmail.com
# Teléfono de contacto que aparece en las plantillas ({mi_telefono})
TELEFONO_CONTACTO=+51 940 009 717
# Texto largo y aleatorio para firmar la sesión (32+ caracteres)
AUTH_SECRET=cambia-esto-por-un-texto-largo-y-aleatorio

# --- Google Places API (New) para la sección Captura ---
GOOGLE_PLACES_API_KEY=
# Topes de consultas a Google (el sistema nunca pasa de 950/mes: cupo gratis = 1.000)
PLACES_MAX_BUSQUEDAS_MES=950
PLACES_MAX_BUSQUEDAS_DIA=30

# --- Meta diaria de contactos nuevos ---
META_DIARIA=50

# --- Recordatorio diario por correo (opcional, resend.com) ---
RESEND_API_KEY=
# Vacío = se envía a todos los TEAM_EMAILS
RECORDATORIO_EMAIL_PARA=
RECORDATORIO_EMAIL_DE=Neoesis CRM <onboarding@resend.dev>
# Vercel lo envía solo al cron; ponle cualquier texto largo
CRON_SECRET=
# URL pública del CRM (para los enlaces del correo)
APP_URL=https://tu-crm.vercel.app

# Tipo de cambio de respaldo si no hay conexión (S/ por US$)
TIPO_CAMBIO=3.55

# Cuenta de Gmail/Google Workspace con la que se abren los correos (ej. ventas@neoesis.pe)
EMAIL_CORPORATIVO=
